# da65 analysis recipe, for the alternate 4 KB bank followed by common E000-E0E4.
# See docs/pcode-native.md for boundaries and generation command.
GLOBAL { STARTADDR $D000; CPU "6502"; PAGELENGTH 0; };
SEGMENT { START $D000; END $E0E4; NAME "PCODE_NATIVE"; };
RANGE { START $D000; END $D0FF; TYPE AddrTable; NAME "opcode_vectors"; };
RANGE { START $D100; END $D151; TYPE AddrTable; NAME "standard_proc_vectors"; };
RANGE { START $D152; END $D1AC; TYPE Code; };
RANGE { START $D1AD; END $D1B6; TYPE WordTable; NAME "interpreter_linkage_base"; };
RANGE { START $D1B7; END $DCF5; TYPE Code; };
RANGE { START $DCF6; END $DCFD; TYPE ByteTable; NAME "single_bit_masks"; };
RANGE { START $DCFE; END $DDD5; TYPE Code; };
RANGE { START $DDD6; END $DDF7; TYPE WordTable; };
RANGE { START $DDF8; END $DE17; TYPE WordTable; };
RANGE { START $DE18; END $DEA3; TYPE Code; };
RANGE { START $DEA4; END $DEA7; TYPE WordTable; };
RANGE { START $DEA8; END $E0E4; TYPE Code; };

LABEL { ADDR $D152; NAME "runtime_entry"; };
LABEL { ADDR $D155; NAME "read_big_word_offset"; };
LABEL { ADDR $D171; NAME "follow_static_links"; };
LABEL { ADDR $D1EF; NAME "unsupported_opcode"; };
